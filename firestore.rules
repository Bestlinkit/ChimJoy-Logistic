rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Public read/write permissions for production client operation
    match /users/{userId} {
      allow read, write, create, update: if true;
    }

    match /admins/{adminId} {
      allow read, write, create, update: if true;
    }

    match /vehicles/{vehicleId} {
      allow read, write, create, update, delete: if true;
    }

    match /fleet/{vehicleId} {
      allow read, write, create, update, delete: if true;
    }

    match /drivers/{driverId} {
      allow read, write, create, update, delete: if true;
    }

    match /bookingRequests/{bookingId} {
      allow read, write, create, update, delete: if true;
    }

    match /carHireBookings/{bookingId} {
      allow read, write, create, update, delete: if true;
    }

    match /reviews/{reviewId} {
      allow read, write, create, update, delete: if true;
    }

    match /messages/{messageId} {
      allow read, write, create, update, delete: if true;
    }

    match /admin_notifications/{notificationId} {
      allow read, write, create, update, delete: if true;
    }

    match /audit_logs/{logId} {
      allow read, write, create, update, delete: if true;
    }

    match /settings/{settingId} {
      allow read, write, create, update, delete: if true;
    }

    // Default match-all rule for production operations
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
