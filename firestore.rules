rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // True when the request is made by an authenticated user.
    function isSignedIn() {
      return request.auth != null;
    }

    // True when the signed-in user is an admin.
    // Bootstraps safely: checks both /admins/ and /admin_users/ docs.
    function isAdmin() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['Super Admin', 'Admin', 'Operations', 'Fleet Manager'])
        ||
        (exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role in ['Super Admin', 'Admin', 'Operations', 'Fleet Manager'])
      );
    }

    // users/{uid} – owner-only access
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // admins/{adminId} & admin_users/{adminId} – signed-in setup & management
    match /admins/{adminId} {
      allow read, write: if isSignedIn();
    }
    match /admin_users/{adminId} {
      allow read, write: if isSignedIn();
    }

    // vehicles (public fleet) – public read, signed-in write
    match /vehicles/{vehicleId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    // bookingRequests – signed-in users only
    match /bookingRequests/{bookingId} {
      allow create, read, update, delete: if isSignedIn();
    }

    // carHireBookings – signed-in users only
    match /carHireBookings/{bookingId} {
      allow create, read, update, delete: if isSignedIn();
    }

    // contact_messages – signed-in users only
    match /contact_messages/{msgId} {
      allow create, read, update, delete: if isSignedIn();
    }

    // reviews – signed-in create, public read, signed-in manages
    match /reviews/{reviewId} {
      allow create: if isSignedIn();
      allow read: if true;
      allow update, delete: if isSignedIn();
    }

    // audit_logs – signed-in write and read
    match /audit_logs/{logId} {
      allow read, write: if isSignedIn();
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
