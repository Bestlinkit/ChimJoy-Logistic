rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // True when the request is made by an authenticated user.
    function isSignedIn() {
      return request.auth != null;
    }

    // True when the signed-in user is an admin.
    // Bootstraps safely: checks both /admins/ and /admin_users/ docs.
    function isAdmin() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['Super Admin', 'Admin', 'Operations', 'Fleet Manager'])
        ||
        (exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role in ['Super Admin', 'Admin', 'Operations', 'Fleet Manager'])
      );
    }

    // users/{uid} – owner-only access
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // admins/{adminId} & admin_users/{adminId} – owner access for setup and profile
    match /admins/{adminId} {
      allow read, write: if isSignedIn() && request.auth.uid == adminId;
    }
    match /admin_users/{adminId} {
      allow read, write: if isSignedIn() && request.auth.uid == adminId;
    }

    // vehicles (public fleet) – public read, admin write
    match /vehicles/{vehicleId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // bookingRequests – authenticated users create and view, admins manage all
    match /bookingRequests/{bookingId} {
      allow create: if isSignedIn();
      allow read, update: if isSignedIn() && (
        resource == null ||
        resource.data.uid == request.auth.uid ||
        resource.data.customerEmail == request.auth.token.email ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // carHireBookings – same rules as bookingRequests
    match /carHireBookings/{bookingId} {
      allow create: if isSignedIn();
      allow read, update: if isSignedIn() && (
        resource == null ||
        resource.data.uid == request.auth.uid ||
        resource.data.customerEmail == request.auth.token.email ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // admin_notifications – admin reads/manages, signed-in users can create
    match /admin_notifications/{notifId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    // drivers – admin only
    match /drivers/{driverId} {
      allow read, write: if isAdmin();
    }

    // customers – admin only
    match /customers/{customerId} {
      allow read, write: if isAdmin();
    }

    // contact_messages – public create, admin manages
    match /contact_messages/{msgId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // reviews – signed-in create, public read, admin manages
    match /reviews/{reviewId} {
      allow create: if isSignedIn();
      allow read: if true;
      allow update, delete: if isAdmin();
    }

    // audit_logs – admin only
    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
